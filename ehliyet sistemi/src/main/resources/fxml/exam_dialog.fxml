<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ehliyet.controllers.ExamDialogController"
      spacing="15" styleClass="exam-dialog" prefWidth="600">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="dialogTitle" text="Yeni Sınav Oluştur" styleClass="dialog-title">
        <font>
            <Font name="System Bold" size="18"/>
        </font>
    </Label>

    <Separator/>

    <!-- Exam Basic Info -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- Exam Name -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
            <Label text="Sınav Adı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <TextField fx:id="examNameField" promptText="Örn: 2024 Ehliyet Sınavı - 1"/>
        </VBox>

        <!-- Exam Code -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Sınav Kodu: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <HBox spacing="5">
                <TextField fx:id="examCodeField" promptText="EXAM-2024-001" HBox.hgrow="ALWAYS"/>
                <Button text="🎲" onAction="#generateExamCode" styleClass="generate-btn">
                    <tooltip>
                        <Tooltip text="Otomatik kod oluştur"/>
                    </tooltip>
                </Button>
            </HBox>
        </VBox>

        <!-- Total Questions -->
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Toplam Soru Sayısı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <Spinner fx:id="totalQuestionsSpinner" editable="true"/>
        </VBox>

        <!-- Duration -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Süre (Dakika): *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <Spinner fx:id="durationSpinner" editable="true"/>
        </VBox>

        <!-- Passing Score -->
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Geçme Puanı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <Spinner fx:id="passingScoreSpinner" editable="true"/>
        </VBox>
    </GridPane>

    <!-- Description -->
    <VBox spacing="5">
        <Label text="Açıklama:">
            <font>
                <Font name="System Bold" size="12"/>
            </font>
        </Label>
        <TextArea fx:id="descriptionArea" promptText="Sınav hakkında açıklama..."
                  wrapText="true" prefRowCount="3"/>
    </VBox>

    <!-- Date Range -->
    <HBox spacing="15">
        <!-- Start Date -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Başlangıç Tarihi:">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <DatePicker fx:id="startDatePicker" prefWidth="250"/>
        </VBox>

        <!-- End Date -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Bitiş Tarihi:">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <DatePicker fx:id="endDatePicker" prefWidth="250"/>
        </VBox>
    </HBox>

    <Separator/>

    <!-- Question Selection Type -->
    <VBox spacing="10">
        <Label text="Soru Seçim Yöntemi: *">
            <font>
                <Font name="System Bold" size="12"/>
            </font>
        </Label>

        <RadioButton fx:id="randomQuestionsRadio" text="Rastgele Soru Seçimi (Tüm sorulardan otomatik seçilir)">
            <font>
                <Font size="12"/>
            </font>
        </RadioButton>

        <RadioButton fx:id="manualQuestionsRadio" text="Manuel Soru Seçimi (Sonra seçeceğim)">
            <font>
                <Font size="12"/>
            </font>
        </RadioButton>
    </VBox>

    <Separator/>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="❌ İptal" onAction="#handleCancel" styleClass="cancel-btn"
                prefWidth="120">
            <font>
                <Font size="13"/>
            </font>
        </Button>
        <Button text="💾 Kaydet" onAction="#handleSave" styleClass="save-btn"
                prefWidth="120">
            <font>
                <Font size="13"/>
            </font>
        </Button>
    </HBox>

    <Label text="* işaretli alanlar zorunludur"
           style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;">
        <font>
            <Font size="11"/>
        </font>
    </Label>

</VBox>
