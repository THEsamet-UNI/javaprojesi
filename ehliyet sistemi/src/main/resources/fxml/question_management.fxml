<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ehliyet.controllers.QuestionManagementController"
      spacing="20" styleClass="question-management">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="❓ Soru Yönetimi" styleClass="page-title">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="➕ Yeni Soru Ekle" onAction="#showAddQuestionDialog"
                styleClass="primary-btn">
            <font>
                <Font size="13"/>
            </font>
        </Button>
    </HBox>

    <Separator/>

    <!-- Filter Section -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="filter-section">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Filtrele:">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
        </Label>

        <ComboBox fx:id="categoryFilterCombo" promptText="Kategori Seç"
                  onAction="#applyFilters" prefWidth="200">
        </ComboBox>

        <ComboBox fx:id="difficultyFilterCombo" promptText="Zorluk Seç"
                  onAction="#applyFilters" prefWidth="150">
        </ComboBox>

        <TextField fx:id="searchField" promptText="🔍 Soru metni ara..."
                   prefWidth="250" onKeyReleased="#applyFilters">
        </TextField>

        <Button text="🔄 Yenile" onAction="#refreshTable" styleClass="refresh-btn">
            <font>
                <Font size="12"/>
            </font>
        </Button>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="totalQuestionsLabel" text="Toplam: 0 soru" styleClass="info-label">
            <font>
                <Font size="13"/>
            </font>
        </Label>
    </HBox>

    <!-- Questions Table -->
    <TableView fx:id="questionsTable" VBox.vgrow="ALWAYS" styleClass="questions-table">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="questionTextCol" text="Soru Metni" prefWidth="350"/>
            <TableColumn fx:id="categoryCol" text="Kategori" prefWidth="150"/>
            <TableColumn fx:id="difficultyCol" text="Zorluk" prefWidth="100"/>
            <TableColumn fx:id="pointsCol" text="Puan" prefWidth="70"/>
            <TableColumn fx:id="correctAnswerCol" text="Doğru Cevap" prefWidth="100"/>
            <TableColumn fx:id="hasImageCol" text="Görsel" prefWidth="80"/>
            <TableColumn fx:id="actionsCol" text="İşlemler" prefWidth="180"/>
        </columns>
    </TableView>

    <!-- Statistics Section -->
    <HBox spacing="20" alignment="CENTER" styleClass="stats-section">
        <padding>
            <Insets top="15" right="10" bottom="10" left="10"/>
        </padding>

        <VBox alignment="CENTER" spacing="5" styleClass="stat-box">
            <Label text="Trafik Kuralları" styleClass="stat-label">
                <font>
                    <Font size="11"/>
                </font>
            </Label>
            <Label fx:id="trafficRulesCount" text="0" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
        </VBox>

        <VBox alignment="CENTER" spacing="5" styleClass="stat-box">
            <Label text="Trafik İşaretleri" styleClass="stat-label">
                <font>
                    <Font size="11"/>
                </font>
            </Label>
            <Label fx:id="signsCount" text="0" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
        </VBox>

        <VBox alignment="CENTER" spacing="5" styleClass="stat-box">
            <Label text="İlk Yardım" styleClass="stat-label">
                <font>
                    <Font size="11"/>
                </font>
            </Label>
            <Label fx:id="firstAidCount" text="0" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
        </VBox>

        <VBox alignment="CENTER" spacing="5" styleClass="stat-box">
            <Label text="Motor" styleClass="stat-label">
                <font>
                    <Font size="11"/>
                </font>
            </Label>
            <Label fx:id="motorCount" text="0" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
        </VBox>
    </HBox>

</VBox>
