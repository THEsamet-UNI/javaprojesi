<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ehliyet.controllers.QuestionDialogController"
      spacing="15" styleClass="question-dialog">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="dialogTitle" text="Yeni Soru Ekle" styleClass="dialog-title">
        <font>
            <Font name="System Bold" size="18"/>
        </font>
    </Label>

    <Separator/>

    <!-- Question Text -->
    <VBox spacing="5">
        <Label text="Soru Metni: *">
            <font>
                <Font name="System Bold" size="12"/>
            </font>
        </Label>
        <TextArea fx:id="questionTextArea" promptText="Soru metnini giriniz..."
                  wrapText="true" prefRowCount="3"/>
    </VBox>

    <!-- Options Grid -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- Option A -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="A Şıkkı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <TextField fx:id="optionAField" promptText="A şıkkı..."/>
        </VBox>

        <!-- Option B -->
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="B Şıkkı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <TextField fx:id="optionBField" promptText="B şıkkı..."/>
        </VBox>

        <!-- Option C -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="C Şıkkı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <TextField fx:id="optionCField" promptText="C şıkkı..."/>
        </VBox>

        <!-- Option D -->
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="D Şıkkı: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <TextField fx:id="optionDField" promptText="D şıkkı..."/>
        </VBox>
    </GridPane>

    <!-- Correct Answer, Category, Difficulty -->
    <HBox spacing="15">
        <!-- Correct Answer -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Doğru Cevap: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <ComboBox fx:id="correctAnswerCombo" maxWidth="Infinity"/>
        </VBox>

        <!-- Category -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Kategori: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity"/>
        </VBox>

        <!-- Difficulty -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Zorluk: *">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <ComboBox fx:id="difficultyCombo" maxWidth="Infinity"/>
        </VBox>

        <!-- Points -->
        <VBox spacing="5">
            <Label text="Puan:">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <Spinner fx:id="pointsSpinner" prefWidth="80" editable="true"/>
        </VBox>
    </HBox>

    <!-- Image Path -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Görsel Yolu (Opsiyonel):">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Label>
            <TextField fx:id="imagePathField" promptText="/images/questions/soru1.jpg"/>
        </VBox>
        <Button text="📁 Seç" onAction="#selectImage" styleClass="select-btn">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
        </Button>
    </HBox>

    <Separator/>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="❌ İptal" onAction="#handleCancel" styleClass="cancel-btn"
                prefWidth="120">
            <font>
                <Font size="13"/>
            </font>
        </Button>
        <Button text="💾 Kaydet" onAction="#handleSave" styleClass="save-btn"
                prefWidth="120">
            <font>
                <Font size="13"/>
            </font>
        </Button>
    </HBox>

    <!-- Info Text (Italic style removed from FXML, will be handled by CSS) -->
    <Label text="* işaretli alanlar zorunludur" styleClass="info-text">
        <font>
            <Font size="11"/>
        </font>
    </Label>

</VBox>
